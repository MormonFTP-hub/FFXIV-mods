<Window x:Class="Authenticator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Authenticator"
        Title="Authenticator" Width="400" Height="640" MinWidth="330" MinHeight="380"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        Icon="Assets/Authenticator.ico" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ContextMenu x:Key="AddMenu" Placement="Bottom">
            <MenuItem Header="Scan QR code on screen" Click="ScanScreen_Click">
                <MenuItem.Icon><TextBlock Text="&#xE7F4;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open QR code image…" InputGestureText="Ctrl+O" Click="OpenImage_Click">
                <MenuItem.Icon><TextBlock Text="&#xEB9F;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Paste QR code or link" InputGestureText="Ctrl+V" Click="Paste_Click">
                <MenuItem.Icon><TextBlock Text="&#xE77F;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Enter setup key…" InputGestureText="Ctrl+N" Click="EnterKey_Click">
                <MenuItem.Icon><TextBlock Text="&#xE765;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="MoreMenu" Placement="Bottom">
            <MenuItem Header="Moving from your phone" Click="Help_Click">
                <MenuItem.Icon><TextBlock Text="&#xE8EA;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Export to Google Authenticator…" Click="ExportGoogle_Click">
                <MenuItem.Icon><TextBlock Text="&#xE72D;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Back up to a file…" Click="Backup_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74E;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Restore from a backup…" Click="Restore_Click">
                <MenuItem.Icon><TextBlock Text="&#xE777;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Always on top" IsCheckable="True" Click="Topmost_Click"/>
            <MenuItem Header="Open data folder" Click="OpenDataFolder_Click">
                <MenuItem.Icon><TextBlock Text="&#xE838;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="AccountTemplate" DataType="{x:Type local:AccountItem}">
            <Border x:Name="Card" Background="{DynamicResource CardBg}" CornerRadius="8" Margin="12,0,12,8" Padding="14,10,12,10"
                    Cursor="Hand" MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseLeftButtonUp="Card_MouseLeftButtonUp" ToolTip="Click to copy the code" ToolTipService.InitialShowDelay="1200">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy code" Click="CopyCode_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE8C8;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy next code" Click="CopyNextCode_Click" Visibility="{Binding IsTotp, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon><TextBlock Text="&#xE72A;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Rename…" Click="Rename_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE8AC;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show QR code and key…" Click="ShowQr_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE890;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Move up" Click="MoveUp_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE70E;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Move down" Click="MoveDown_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE70D;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete…" Click="Delete_Click">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Foreground="{DynamicResource SubText}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="CodeText" Text="{Binding Code}" FontSize="30" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       Foreground="{DynamicResource Accent}" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="FlashText" Text="{Binding FlashText}" Foreground="{DynamicResource SubText}" FontSize="12"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="RingHost" Grid.Column="2" Width="32" Height="32" VerticalAlignment="Center">
                        <local:CountdownRing x:Name="Ring" Progress="{Binding Progress}" Thickness="3"
                                             Stroke="{DynamicResource Accent}" Track="{DynamicResource Track}"/>
                        <TextBlock Text="{Binding SecondsLeft}" FontSize="11" Foreground="{DynamicResource SubText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            ToolTip="Show the next code" AutomationProperties.Name="Show the next code" Click="NextHotp_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FlashText}" Value="{x:Null}">
                    <Setter TargetName="FlashText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                    <Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHotp}" Value="True">
                    <Setter TargetName="RingHost" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NextButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCode}" Value="False">
                    <Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource SubText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Tag="Search" AutomationProperties.Name="Search" Padding="30,7,8,7" TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Type to filter, Enter copies the first code"
                     ToolTipService.InitialShowDelay="1500"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource SubText}"
                       Margin="11,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" Margin="6,0,0,0"
                    ToolTip="Add an account" AutomationProperties.Name="Add an account" Click="AddButton_Click"/>
            <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="2,0,0,0"
                    ToolTip="More" AutomationProperties.Name="More" Click="MoreButton_Click"/>
        </Grid>

        <ScrollViewer x:Name="ListScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="AccountList" ItemTemplate="{StaticResource AccountTemplate}" Focusable="False" Padding="0,0,0,4"/>
        </ScrollViewer>

        <TextBlock x:Name="NoMatches" Grid.Row="1" Text="No accounts match your search." Foreground="{DynamicResource SubText}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>

        <ScrollViewer x:Name="EmptyState" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel Margin="24,12,24,16" MaxWidth="380">
                <TextBlock Text="No accounts yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Add the accounts you have in Google Authenticator, and this PC shows the same codes as your phone."
                           Foreground="{DynamicResource SubText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                <Button Style="{StaticResource AccentButton}" Click="ScanScreen_Click" Margin="0,0,0,8" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Scan QR code on screen"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OpenImage_Click" Margin="0,0,0,8" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Open QR code image…"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="EnterKey_Click" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Enter setup key…"/>
                    </StackPanel>
                </Button>
                <Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="14,12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Moving everything from your phone" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HelpText" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,2,16,8" FontSize="11.5" Foreground="{DynamicResource SubText}"
                   TextTrimming="CharacterEllipsis"/>

        <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,34"
                CornerRadius="16" Padding="16,8" Background="{DynamicResource ToastBg}" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource ToastText}" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
