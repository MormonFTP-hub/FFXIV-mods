<Window x:Class="Authenticator.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticator" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="22,16,22,18">
        <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource SubText}" Margin="0,6,0,0" LineHeight="18"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
        <PasswordBox x:Name="PasswordBox1"/>
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Type it again"/>
            <PasswordBox x:Name="PasswordBox2"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
