<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xivrender</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>CS8500;CA1416</NoWarn>
    <PenumbraDir>$(APPDATA)\XIVLauncher\installedPlugins\Penumbra\1.7.2.1</PenumbraDir>
    <DalamudDir>$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lumina"><HintPath>$(DalamudDir)\Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudDir)\Lumina.Excel.dll</HintPath></Reference>
    <Reference Include="TerraFX.Interop.Windows"><HintPath>$(DalamudDir)\TerraFX.Interop.Windows.dll</HintPath></Reference>
    <Reference Include="Penumbra.GameData"><HintPath>$(PenumbraDir)\Penumbra.GameData.dll</HintPath></Reference>
    <Reference Include="Penumbra.String"><HintPath>$(PenumbraDir)\Penumbra.String.dll</HintPath></Reference>
    <Reference Include="Luna"><HintPath>$(PenumbraDir)\Luna.dll</HintPath></Reference>
    <Reference Include="OtterTex"><HintPath>$(PenumbraDir)\OtterTex.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudDir)\Dalamud.dll</HintPath></Reference>
    <Reference Include="Serilog"><HintPath>$(DalamudDir)\Serilog.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DalamudDir)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="CommunityToolkit.HighPerformance"><HintPath>$(DalamudDir)\CommunityToolkit.HighPerformance.dll</HintPath></Reference>
  </ItemGroup>

</Project>
